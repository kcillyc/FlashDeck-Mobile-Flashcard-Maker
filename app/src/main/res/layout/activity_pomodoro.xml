<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FAF8FC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="20dp" android:background="@color/purple_500">
        <TextView android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="56dp" android:gravity="center" android:text="‹" android:textColor="@color/white" android:textSize="38sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pomodoro timer" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/phaseText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="Study time" android:textColor="@color/purple_500" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/timerText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="25:00" android:textColor="#2D2639" android:textSize="56sp" android:textStyle="bold" />
            <TextView android:id="@+id/settingsLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Timer settings" android:textColor="#555555" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/studyMinutesInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Study minutes" android:inputType="number" android:maxLength="3" android:text="25" />
                <EditText android:id="@+id/restMinutesInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:hint="Rest minutes" android:inputType="number" android:maxLength="3" android:text="5" />
            </LinearLayout>
            <CheckBox android:id="@+id/unlimitedCheckBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Unlimited timer" android:textColor="#2D2639" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp" android:orientation="horizontal">
                <TextView android:id="@+id/startPauseButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/button_gold" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Start" android:textColor="@color/white" android:textSize="15sp" />
                <TextView android:id="@+id/resetButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/button_status_white" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Reset" android:textColor="@color/purple_500" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
