<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FAF8FC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="20dp" android:background="@color/purple_500">
        <TextView android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="56dp" android:gravity="center" android:text="‹" android:textColor="@color/white" android:textSize="38sp" />
        <TextView android:id="@+id/toolbarTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
    <Button android:id="@+id/addCardButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginStart="20dp" android:layout_marginTop="16dp" android:layout_marginEnd="20dp" android:background="@drawable/button_gold" android:text="+  Add flashcard" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" />
    <TextView android:id="@+id/viewAllButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginStart="20dp" android:layout_marginTop="10dp" android:layout_marginEnd="20dp" android:background="@drawable/button_status_white" android:clickable="true" android:focusable="true" android:gravity="center" android:text="View all terms and answers" android:textColor="@color/purple_500" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="20dp" android:layout_marginTop="8dp" android:layout_marginEnd="20dp" android:clipChildren="false" android:clipToPadding="false" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/shuffleButton" android:layout_width="76dp" android:layout_height="38dp" android:background="@drawable/button_status_white" android:clickable="true" android:elevation="2dp" android:focusable="true" android:gravity="center" android:text="Shuffle" android:textColor="#5B3794" android:textSize="12sp" />
        <TextView android:id="@+id/restartMenuButton" android:layout_width="32dp" android:layout_height="38dp" android:layout_marginStart="4dp" android:background="@android:color/transparent" android:clickable="true" android:focusable="true" android:gravity="center" android:text="☰" android:textColor="#5B3794" android:textSize="20sp" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/studyTimerText" android:layout_width="78dp" android:layout_height="38dp" android:layout_marginEnd="6dp" android:background="@drawable/timer_study_background" android:clickable="true" android:elevation="2dp" android:focusable="true" android:gravity="center" android:text="00:00" android:textColor="#874B14" android:textSize="13sp" />
        <Spinner android:id="@+id/filterSpinner" android:layout_width="132dp" android:layout_height="38dp" android:background="@drawable/button_status_white" android:clipToOutline="true" android:elevation="2dp" android:spinnerMode="dropdown" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="20dp" android:layout_marginTop="10dp" android:layout_marginEnd="20dp" android:layout_marginBottom="16dp">
        <TextView android:id="@+id/studyCard" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/flashcard_surface" android:gravity="center" android:padding="28dp" android:textColor="#2D2639" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/cardProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="14dp" android:gravity="center" android:textColor="#777777" android:textSize="14sp" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:orientation="horizontal">
        <Button android:id="@+id/previousButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/button_purple" android:text="‹" android:textColor="@color/white" android:textSize="28sp" />
        <Button android:id="@+id/nextButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/button_purple" android:text="›" android:textColor="@color/white" android:textSize="28sp" />
    </LinearLayout>
    <TextView android:id="@+id/statusInstruction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="How well do you know this card?" android:textColor="#555555" android:textSize="14sp" />
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:textColor="#777777" android:textSize="14sp" />
    <LinearLayout android:id="@+id/statusButtons" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginStart="20dp" android:layout_marginTop="6dp" android:layout_marginEnd="20dp" android:orientation="horizontal">
        <TextView android:id="@+id/reviewButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/button_status_white" android:clickable="true" android:focusable="true" android:gravity="center" android:text="To review" android:textColor="#C18E00" android:textSize="14sp" />
        <TextView android:id="@+id/memorizedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/button_status_white" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Memorized" android:textColor="#2E964E" android:textSize="14sp" />
    </LinearLayout>
    <FrameLayout android:id="@+id/futureButtonsSpace" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:layout_marginBottom="8dp" />
</LinearLayout>
